# Copy to backend/.env and fill in. Never commit the real file.

# --- Language model. "none" keeps every agent on its rule-based logic.
LLM_PROVIDER=none            # none | gemini | groq | ollama | openai_compatible
LLM_API_KEY=                 # not needed for ollama
LLM_MODEL=                   # empty: provider default (check it still exists on the provider's model list)
LLM_BASE_URL=                # only for openai_compatible, e.g. http://localhost:1234/v1
LLM_MIN_INTERVAL_SECONDS=0   # raise it (for example 4) if the free tier answers 429

# Examples
#   LLM_PROVIDER=gemini   LLM_API_KEY=<key from Google AI Studio>
#   LLM_PROVIDER=groq     LLM_API_KEY=<key from console.groq.com>
#   LLM_PROVIDER=ollama   LLM_MODEL=llama3.2        (run "ollama pull llama3.2" first)

# --- Decision policy
MODEL_VARIANT=full           # full (audited model) | unaware (protected attributes removed)
REFUSAL_THRESHOLD=           # empty: balanced threshold stored with the model
BORDERLINE_MARGIN=0.02
ROBUST_MARGIN=0.02
MAX_CF_ATTEMPTS=3

# --- Interface pacing: pause between agents so each step is visible
STEP_DELAY_SECONDS=0.7
